{
  "manifest_version": 3,
  "name": "HotMic — Microphone Sharing for Google Meet",
  "short_name": "HotMic",
  "version": "1.3.1",
  "description": "Coordinates Google Meet microphone ownership between people in the same room. Controls Meet's mute state only; never transmits audio.",
  "minimum_chrome_version": "111",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Microphone Sharing",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content/meet-adapter.js",
        "src/content/overlay.js",
        "src/content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
